{
  "name": "iota-agent-mcp",
  "version": "1.0.0",
  "description": "IOTA blockchain MCP server for AI agents — wallet management, Move development, on-chain queries, and transaction signing via Model Context Protocol",
  "main": "dist/index.js",
  "bin": {
    "iota-agent-mcp": "dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "npx tsx src/index.ts",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "iota",
    "blockchain",
    "mcp",
    "model-context-protocol",
    "claude",
    "ai",
    "wallet",
    "move",
    "smart-contract",
    "agent",
    "web3"
  ],
  "author": "IOTA Foundation",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iotaledger/iota-rust-sdk.git",
    "directory": "iota-mcp-server"
  },
  "homepage": "https://github.com/iotaledger/iota-rust-sdk/tree/main/iota-mcp-server",
  "bugs": {
    "url": "https://github.com/iotaledger/iota-rust-sdk/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.0",
    "tsx": "^4.19.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
