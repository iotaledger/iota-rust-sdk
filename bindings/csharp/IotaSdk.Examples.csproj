<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="IotaSdk.Bindings.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Milestone 1: examples are scaffolded but excluded from compilation until generated bindings land. -->
    <Compile Remove="examples/**/*.cs" />
    <None Include="examples/**/*.cs" />
  </ItemGroup>
</Project>
