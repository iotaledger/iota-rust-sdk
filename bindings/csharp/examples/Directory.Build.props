<Project>
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Prevent multiple main issues if dotnet build is run at the folder level accidentally -->
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Release'">
    <ProjectReference Include="..\..\src\IotaSdk\IotaSdk.csproj" />
  </ItemGroup>
</Project>
