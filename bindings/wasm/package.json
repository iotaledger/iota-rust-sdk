{
  "name": "iota-sdk-wasm",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/iotaledger/iota-rust-sdk"
  },
  "type": "module",
  "browser": "src/ts/index.web.ts",
  "main": "dist/iota-sdk.js",
  "module": "dist/iota-sdk.js",
  "types": "dist/types/index.web.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "fix-generated": "node ./scripts/fix-generated-typescript.mjs",
    "build:types": "tsc -p tsconfig.types.json",
    "build": "pnpm run fix-generated && mkdir -p dist && esbuild src/ts/index.web.ts --bundle --format=esm --outfile=dist/iota-sdk.js && cp src/ts/wasm-bindgen/index_bg.wasm dist/ && pnpm run build:types",
    "serve": "pnpm run build && node scripts/serve.mjs 5173",
    "examples:format": "prettier --write examples",
    "examples:format-check": "prettier --check examples"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0"
  },
  "packageManager": "pnpm@10.14.0",
  "dependencies": {
    "uniffi-bindgen-react-native": "0.29.3-1"
  }
}
