{
  "name": "iota-sdk-wasm",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/iotaledger/iota-rust-sdk"
  },
  "browser": "src/ts/index.web.ts",
  "scripts": {
    "fix-generated": "node ./scripts/fix-generated-typescript.mjs",
    "build": "pnpm run fix-generated && mkdir -p dist && esbuild src/ts/index.web.ts --bundle --format=esm --outfile=dist/iota-sdk.js && cp src/ts/wasm-bindgen/index_bg.wasm dist/",
    "serve": "pnpm run build && node scripts/serve.mjs 5173"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "packageManager": "pnpm@10.14.0",
  "dependencies": {
    "uniffi-bindgen-react-native": "0.29.3-1"
  }
}
