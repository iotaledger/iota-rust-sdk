interface Error {};

interface Client {
    [Throws=Error]
    constructor([ByRef] string server);

    [Name=new_mainnet]
    constructor();

    [Name=new_testnet]
    constructor();

    [Name=new_devnet]
    constructor();

    [Name=new_localhost]
    constructor();

    [Async, Throws=Error]
    string chain_id();
};

namespace client {};
