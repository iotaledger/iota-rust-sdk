; Auto-generated BCS schema definitions
; Do not edit manually

bag = uid   ; id
      u64   ; size

balance = u64   ; value

basic-output = uid                                                     ; id
               balance                                                 ; balance
               bag                                                     ; native-tokens
               (%d00 / %d01 storage-deposit-return-unlock-condition)   ; storage-deposit-return
               (%d00 / %d01 timelock-unlock-condition)                 ; timelock
               (%d00 / %d01 expiration-unlock-condition)               ; expiration
               (%d00 / %d01 bytes)                                     ; metadata
               (%d00 / %d01 bytes)                                     ; tag
               (%d00 / %d01 address)                                   ; sender

bool    = %d00   ; false
        / %d01   ; true

bytes   = size *OCTET

coin = uid       ; id
       balance   ; balance

coin-metadata = uid                    ; id
                u8                     ; decimals
                string                 ; name
                string                 ; symbol
                string                 ; description
                (%d00 / %d01 string)   ; icon-url

display = uid       ; id
          vec-map   ; fields
          u16       ; version

expiration-unlock-condition = address   ; owner
                              address   ; return-address
                              u32       ; unix-time

fixed-point32 = u64   ; value

i64     = 8OCTET

id = object-id   ; bytes

iota-system-admin-cap = bool   ; dummy-field

iota-system-state-v1 = u64                     ; epoch
                       u64                     ; protocol-version
                       u64                     ; system-state-version
                       iota-treasury-cap       ; iota-treasury-cap
                       validator-set-v1        ; validators
                       storage-fund-v1         ; storage-fund
                       system-parameters-v1    ; parameters
                       iota-system-admin-cap   ; iota-system-admin-cap
                       u64                     ; reference-gas-price
                       vec-map                 ; validator-report-records
                       bool                    ; safe-mode
                       balance                 ; safe-mode-storage-charges
                       balance                 ; safe-mode-computation-rewards
                       u64                     ; safe-mode-storage-rebates
                       u64                     ; safe-mode-non-refundable-storage-fee
                       u64                     ; epoch-start-timestamp-ms
                       bag                     ; extra-fields

iota-system-state-v2 = u64                     ; epoch
                       u64                     ; protocol-version
                       u64                     ; system-state-version
                       iota-treasury-cap       ; iota-treasury-cap
                       validator-set-v2        ; validators
                       storage-fund-v1         ; storage-fund
                       system-parameters-v1    ; parameters
                       iota-system-admin-cap   ; iota-system-admin-cap
                       u64                     ; reference-gas-price
                       vec-map                 ; validator-report-records
                       bool                    ; safe-mode
                       balance                 ; safe-mode-storage-charges
                       balance                 ; safe-mode-computation-charges
                       u64                     ; safe-mode-computation-charges-burned
                       u64                     ; safe-mode-storage-rebates
                       u64                     ; safe-mode-non-refundable-storage-fee
                       u64                     ; epoch-start-timestamp-ms
                       bag                     ; extra-fields

iota-system-state-wrapper = uid   ; id
                            u64   ; version

iota-treasury-cap = treasury-cap   ; inner

irc27-metadata = string                 ; version
                 string                 ; media-type
                 url                    ; uri
                 string                 ; name
                 (%d00 / %d01 string)   ; collection-name
                 vec-map                ; royalties
                 (%d00 / %d01 string)   ; issuer-name
                 (%d00 / %d01 string)   ; description
                 vec-map                ; attributes
                 vec-map                ; non-standard-fields

nft = uid                     ; id
      (%d00 / %d01 address)   ; legacy-sender
      (%d00 / %d01 bytes)     ; metadata
      (%d00 / %d01 bytes)     ; tag
      (%d00 / %d01 address)   ; immutable-issuer
      irc27-metadata          ; immutable-metadata

nft-output = uid                                                     ; id
             balance                                                 ; balance
             bag                                                     ; native-tokens
             (%d00 / %d01 storage-deposit-return-unlock-condition)   ; storage-deposit-return
             (%d00 / %d01 timelock-unlock-condition)                 ; timelock
             (%d00 / %d01 expiration-unlock-condition)               ; expiration

pool-token-exchange-rate = u64   ; iota-amount
                           u64   ; pool-token-amount

receiving = id    ; id
            u64   ; version

size    = uleb128   ; BCS sequence/string length (ULEB128-encoded)

staked-iota = uid       ; id
              id        ; pool-id
              u64       ; stake-activation-epoch
              balance   ; principal

staking-pool-v1 = uid                 ; id
                  (%d00 / %d01 u64)   ; activation-epoch
                  (%d00 / %d01 u64)   ; deactivation-epoch
                  u64                 ; iota-balance
                  balance             ; rewards-pool
                  u64                 ; pool-token-balance
                  table               ; exchange-rates
                  u64                 ; pending-stake
                  u64                 ; pending-total-iota-withdraw
                  u64                 ; pending-pool-token-withdraw
                  bag                 ; extra-fields

storage-deposit-return-unlock-condition = address   ; return-address
                                          u64       ; return-amount

storage-fund-v1 = balance   ; total-object-storage-rebates
                  balance   ; non-refundable-balance

string  = size *OCTET   ; UTF-8 encoded

supply = u64   ; value

system-epoch-info-event-v1 = u64   ; epoch
                             u64   ; protocol-version
                             u64   ; reference-gas-price
                             u64   ; total-stake
                             u64   ; storage-charge
                             u64   ; storage-rebate
                             u64   ; storage-fund-balance
                             u64   ; total-gas-fees
                             u64   ; total-stake-rewards-distributed
                             u64   ; burnt-tokens-amount
                             u64   ; minted-tokens-amount

system-epoch-info-event-v2 = u64   ; epoch
                             u64   ; protocol-version
                             u64   ; total-stake
                             u64   ; storage-charge
                             u64   ; storage-rebate
                             u64   ; storage-fund-balance
                             u64   ; total-gas-fees
                             u64   ; total-stake-rewards-distributed
                             u64   ; burnt-tokens-amount
                             u64   ; minted-tokens-amount
                             u64   ; tips-amount

system-parameters-v1 = u64   ; epoch-duration-ms
                       u64   ; min-validator-count
                       u64   ; max-validator-count
                       u64   ; min-validator-joining-stake
                       u64   ; validator-low-stake-threshold
                       u64   ; validator-very-low-stake-threshold
                       u64   ; validator-low-stake-grace-period
                       bag   ; extra-fields

table = uid   ; id
        u64   ; size

table-vec = table   ; contents

timelock-unlock-condition = u32   ; unix-time

timelocked-staked-iota = uid                    ; id
                         staked-iota            ; staked-iota
                         u64                    ; expiration-timestamp-ms
                         (%d00 / %d01 string)   ; label

treasury-cap = uid      ; id
               supply   ; total-supply

u128    = 16OCTET

u16     = 2OCTET

u32     = 4OCTET

u64     = 8OCTET

u8      = 1OCTET

uid = id   ; id

uleb128 = *(%x80-FF) %x00-7F   ; variable-length unsigned integer

unverified-validator-operation-cap = uid       ; id
                                     address   ; authorizer-validator-address

url = string

validator-metadata-v1 = address                ; iota-address
                        bytes                  ; authority-pubkey-bytes
                        bytes                  ; network-pubkey-bytes
                        bytes                  ; protocol-pubkey-bytes
                        bytes                  ; proof-of-possession-bytes
                        string                 ; name
                        string                 ; description
                        string                 ; image-url
                        string                 ; project-url
                        string                 ; net-address
                        string                 ; p2p-address
                        string                 ; primary-address
                        (%d00 / %d01 bytes)    ; next-epoch-authority-pubkey-bytes
                        (%d00 / %d01 bytes)    ; next-epoch-proof-of-possession
                        (%d00 / %d01 bytes)    ; next-epoch-network-pubkey-bytes
                        (%d00 / %d01 bytes)    ; next-epoch-protocol-pubkey-bytes
                        (%d00 / %d01 string)   ; next-epoch-net-address
                        (%d00 / %d01 string)   ; next-epoch-p2p-address
                        (%d00 / %d01 string)   ; next-epoch-primary-address
                        bag                    ; extra-fields

validator-set-v1 = u64                    ; total-stake
                   (size *validator-v1)   ; active-validators
                   table-vec              ; pending-active-validators
                   (size *u64)            ; pending-removals
                   table                  ; staking-pool-mappings
                   table                  ; inactive-validators
                   table                  ; validator-candidates
                   vec-map                ; at-risk-validators
                   bag                    ; extra-fields

validator-set-v2 = u64                    ; total-stake
                   (size *validator-v1)   ; active-validators
                   (size *u64)            ; committee-members
                   table-vec              ; pending-active-validators
                   (size *u64)            ; pending-removals
                   table                  ; staking-pool-mappings
                   table                  ; inactive-validators
                   table                  ; validator-candidates
                   vec-map                ; at-risk-validators
                   bag                    ; extra-fields

validator-v1 = validator-metadata-v1   ; metadata
               u64                     ; voting-power
               id                      ; operation-cap-id
               u64                     ; gas-price
               staking-pool-v1         ; staking-pool
               u64                     ; commission-rate
               u64                     ; next-epoch-stake
               u64                     ; next-epoch-gas-price
               u64                     ; next-epoch-commission-rate
               bag                     ; extra-fields

validator-wrapper = versioned   ; inner

versioned = uid   ; id
            u64   ; version
