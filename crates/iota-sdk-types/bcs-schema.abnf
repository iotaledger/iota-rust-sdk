; Auto-generated BCS schema definitions
; Do not edit manually

active-jwk = jwk-id   ; jwk-id
             jwk      ; jwk
             u64      ; epoch

address = 32OCTET

argument = %x00   ; Gas
         / %x01 u16   ; Input
         / %x02 u16   ; Result
         / %x03 u16 u16   ; NestedResult

authenticator-state-expire = u64   ; min-epoch
                             u64   ; authenticator-obj-initial-shared-version

authenticator-state-update-v1 = u64                   ; epoch
                                u64                   ; round
                                (vector active-jwk)   ; new-active-jwks
                                u64                   ; authenticator-obj-initial-shared-version

bls12381-public-key = bytes

bls12381-signature = 48OCTET

call-arg = %x00 bytes   ; Pure
         / %x01 object-arg   ; Object

cancelled-transaction = digest                        ; digest
                        (vector version-assignment)   ; version-assignments

change-epoch = u64                       ; epoch
               u64                       ; protocol-version
               u64                       ; storage-charge
               u64                       ; computation-charge
               u64                       ; storage-rebate
               u64                       ; non-refundable-storage-fee
               u64                       ; epoch-start-timestamp-ms
               (vector system-package)   ; system-packages

change-epoch-v2 = u64                       ; epoch
                  u64                       ; protocol-version
                  u64                       ; storage-charge
                  u64                       ; computation-charge
                  u64                       ; computation-charge-burned
                  u64                       ; storage-rebate
                  u64                       ; non-refundable-storage-fee
                  u64                       ; epoch-start-timestamp-ms
                  (vector system-package)   ; system-packages

change-epoch-v3 = u64                       ; epoch
                  u64                       ; protocol-version
                  u64                       ; storage-charge
                  u64                       ; computation-charge
                  u64                       ; computation-charge-burned
                  u64                       ; storage-rebate
                  u64                       ; non-refundable-storage-fee
                  u64                       ; epoch-start-timestamp-ms
                  (vector system-package)   ; system-packages
                  (vector u64)              ; eligible-active-validators

change-epoch-v4 = u64                       ; epoch
                  u64                       ; protocol-version
                  u64                       ; storage-charge
                  u64                       ; computation-charge
                  u64                       ; computation-charge-burned
                  u64                       ; storage-rebate
                  u64                       ; non-refundable-storage-fee
                  u64                       ; epoch-start-timestamp-ms
                  (vector system-package)   ; system-packages
                  (vector u64)              ; eligible-active-validators
                  (vector u64)              ; scores
                  bool                      ; adjust-rewards-by-score

changed-object = object-id      ; object-id
                 object-in      ; input-state
                 object-out     ; output-state
                 id-operation   ; id-operation

checkpoint-commitment = %x00 digest   ; EcmhLiveObjectSet

checkpoint-contents = (vector checkpoint-transaction-info)

checkpoint-data = signed-checkpoint-summary         ; checkpoint-summary
                  checkpoint-contents               ; checkpoint-contents
                  (vector checkpoint-transaction)   ; transactions

checkpoint-summary = u64                              ; epoch
                     u64                              ; sequence-number
                     u64                              ; network-total-transactions
                     digest                           ; content-digest
                     (option digest)                  ; previous-digest
                     gas-cost-summary                 ; epoch-rolling-gas-cost-summary
                     u64                              ; timestamp-ms
                     (vector checkpoint-commitment)   ; checkpoint-commitments
                     (option end-of-epoch-data)       ; end-of-epoch-data
                     bytes                            ; version-specific-data

checkpoint-transaction = signed-transaction            ; transaction
                         transaction-effects           ; effects
                         (option transaction-events)   ; events
                         (vector object)               ; input-objects
                         (vector object)               ; output-objects

checkpoint-transaction-info = digest                    ; transaction
                              digest                    ; effects
                              (vector user-signature)   ; signatures

command = %x00 move-call   ; MoveCall
        / %x01 transfer-objects   ; TransferObjects
        / %x02 split-coins   ; SplitCoins
        / %x03 merge-coins   ; MergeCoins
        / %x04 publish   ; Publish
        / %x05 make-move-vector   ; MakeMoveVector
        / %x06 upgrade   ; Upgrade

command-argument-error = %x00   ; TypeMismatch
                       / %x01   ; InvalidBcsBytes
                       / %x02   ; InvalidUsageOfPureArgument
                       / %x03   ; InvalidArgumentToPrivateEntryFunction
                       / %x04 u16   ; IndexOutOfBounds
                       / %x05 u16 u16   ; SecondaryIndexOutOfBounds
                       / %x06 u16   ; InvalidResultArity
                       / %x07   ; InvalidGasCoinUsage
                       / %x08   ; InvalidValueUsage
                       / %x09   ; InvalidObjectByValue
                       / %x0a   ; InvalidObjectByMutRef
                       / %x0b   ; SharedObjectOperationNotAllowed
                       / %x0c   ; InvalidArgumentArity

compressed-struct-tag = %x00 struct-tag   ; Other
                      / %x01   ; GasCoin
                      / %x02   ; StakedIota
                      / %x03 type-tag   ; Coin

consensus-commit-prologue-v1 = u64                                        ; epoch
                               u64                                        ; round
                               (option u64)                               ; sub-dag-index
                               u64                                        ; commit-timestamp-ms
                               digest                                     ; consensus-commit-digest
                               consensus-determined-version-assignments   ; consensus-determined-version-assignments

consensus-determined-version-assignments = %x00 (vector cancelled-transaction)   ; CancelledTransactions

digest = %x20 32OCTET

end-of-epoch-data = (vector validator-committee-member)   ; next-epoch-committee
                    u64                                   ; next-epoch-protocol-version
                    (vector checkpoint-commitment)        ; epoch-commitments
                    i64                                   ; epoch-supply-change

end-of-epoch-transaction-kind = %x00 change-epoch   ; ChangeEpoch
                              / %x01 change-epoch-v2   ; ChangeEpochV2
                              / %x02 change-epoch-v3   ; ChangeEpochV3
                              / %x03 change-epoch-v4   ; ChangeEpochV4
                              / %x04   ; AuthenticatorStateCreate
                              / %x05 authenticator-state-expire   ; AuthenticatorStateExpire

event = object-id    ; package-id
        identifier   ; module
        address      ; sender
        struct-tag   ; type-
        bytes        ; contents

execution-error = %x00   ; InsufficientGas
                / %x01   ; InvalidGasObject
                / %x02   ; InvariantViolation
                / %x03   ; FeatureNotYetSupported
                / %x04 u64 u64   ; ObjectTooBig
                / %x05 u64 u64   ; PackageTooBig
                / %x06 object-id   ; CircularObjectOwnership
                / %x07   ; InsufficientCoinBalance
                / %x08   ; CoinBalanceOverflow
                / %x09   ; PublishErrorNonZeroAddress
                / %x0a   ; IotaMoveVerificationError
                / %x0b (option move-location)   ; MovePrimitiveRuntimeError
                / %x0c move-location u64   ; MoveAbort
                / %x0d   ; VmVerificationOrDeserializationError
                / %x0e   ; VmInvariantViolation
                / %x0f   ; FunctionNotFound
                / %x10   ; ArityMismatch
                / %x11   ; TypeArityMismatch
                / %x12   ; NonEntryFunctionInvoked
                / %x13 u16 command-argument-error   ; CommandArgumentError
                / %x14 u16 type-argument-error   ; TypeArgumentError
                / %x15 u16 u16   ; UnusedValueWithoutDrop
                / %x16 u16   ; InvalidPublicFunctionReturnType
                / %x17   ; InvalidTransferObject
                / %x18 u64 u64   ; EffectsTooLarge
                / %x19   ; PublishUpgradeMissingDependency
                / %x1a   ; PublishUpgradeDependencyDowngrade
                / %x1b package-upgrade-error   ; PackageUpgradeError
                / %x1c u64 u64   ; WrittenObjectsTooLarge
                / %x1d   ; CertificateDenied
                / %x1e   ; IotaMoveVerificationTimeout
                / %x1f   ; SharedObjectOperationNotAllowed
                / %x20   ; InputObjectDeleted
                / %x21 (vector object-id)   ; ExecutionCancelledDueToSharedObjectCongestion
                / %x22 address string   ; AddressDeniedForCoin
                / %x23 string   ; CoinTypeGlobalPause
                / %x24   ; ExecutionCancelledDueToRandomnessUnavailable
                / %x25 (vector object-id) u64   ; ExecutionCancelledDueToSharedObjectCongestionV2
                / %x26   ; InvalidLinkage

execution-status = %x00   ; Success
                 / %x01 execution-error (option u64)   ; Failure

execution-time-observation = execution-time-observation-key                  ; key
                             (vector validator-execution-time-observation)   ; observations

execution-time-observation-key = %x00 object-id string string (vector type-tag)   ; MoveEntryPoint
                               / %x01   ; TransferObjects
                               / %x02   ; SplitCoins
                               / %x03   ; MergeCoins
                               / %x04   ; Publish
                               / %x05   ; MakeMoveVec
                               / %x06   ; Upgrade

execution-time-observations = %x00 (vector execution-time-observation)   ; V1

gas-cost-summary = u64   ; computation-cost
                   u64   ; computation-cost-burned
                   u64   ; storage-cost
                   u64   ; storage-rebate
                   u64   ; non-refundable-storage-fee

gas-payment = (vector object-reference)   ; objects
              address                     ; owner
              u64                         ; price
              u64                         ; budget

genesis-object = object-data   ; data
                 owner         ; owner

genesis-transaction = (vector genesis-object)   ; objects
                      (vector event)            ; events

id-operation = %x00   ; None
             / %x01   ; Created
             / %x02   ; Deleted

identifier = string

input = call-arg

intent = intent-scope     ; scope
         intent-version   ; version
         intent-app-id    ; app-id

intent-app-id = u8

intent-scope = u8

intent-version = u8

jwk = string   ; kty
      string   ; e
      string   ; n
      string   ; alg

jwk-id = string   ; iss
         string   ; kid

make-move-vector = (option type-tag)   ; type-
                   (vector argument)   ; elements

merge-coins = argument            ; coin
              (vector argument)   ; coins-to-merge

move-call = object-id           ; package
            identifier          ; module
            identifier          ; function
            (vector type-tag)   ; type-arguments
            (vector argument)   ; arguments

move-location = object-id             ; package
                identifier            ; module
                u16                   ; function
                u16                   ; instruction
                (option identifier)   ; function-name

move-package = object-id                      ; id
               u64                            ; version
               (map identifier bytes)         ; modules
               (vector type-origin)           ; type-origin-table
               (map object-id upgrade-info)   ; linkage-table

move-struct = compressed-struct-tag   ; type-
              u64                     ; version
              bytes                   ; contents

object = object-data   ; data
         owner         ; owner
         digest        ; previous-transaction
         u64           ; storage-rebate

object-arg = %x00 object-reference   ; ImmutableOrOwned
           / %x01 object-id u64 bool   ; Shared
           / %x02 object-reference   ; Receiving

object-data = %x00 move-struct   ; Struct
            / %x01 move-package   ; Package

object-id = address

object-in = %x00   ; Missing
          / %x01 u64 digest owner   ; Data

object-out = %x00   ; Missing
           / %x01 digest owner   ; ObjectWrite
           / %x02 u64 digest   ; PackageWrite

object-reference = object-id   ; object-id
                   u64         ; version
                   digest      ; digest

owner = %x00 address   ; Address
      / %x01 object-id   ; Object
      / %x02 u64   ; Shared
      / %x03   ; Immutable

package-upgrade-error = %x00 object-id   ; UnableToFetchPackage
                      / %x01 object-id   ; NotAPackage
                      / %x02   ; IncompatibleUpgrade
                      / %x03 digest   ; DigestDoesNotMatch
                      / %x04 u8   ; UnknownUpgradePolicy
                      / %x05 object-id object-id   ; PackageIdDoesNotMatch

programmable-transaction = (vector input)     ; inputs
                           (vector command)   ; commands

publish = (vector bytes)       ; modules
          (vector object-id)   ; dependencies

randomness-state-update = u64     ; epoch
                          u64     ; randomness-round
                          bytes   ; random-bytes
                          u64     ; randomness-obj-initial-shared-version

signed-checkpoint-summary = checkpoint-summary               ; checkpoint
                            validator-aggregated-signature   ; signature

signed-transaction = transaction               ; transaction
                     (vector user-signature)   ; signatures

split-coins = argument            ; coin
              (vector argument)   ; amounts

struct-tag = address             ; address
             identifier          ; module
             identifier          ; name
             (vector type-tag)   ; type-params

system-package = u64                  ; version
                 (vector bytes)       ; modules
                 (vector object-id)   ; dependencies

transaction = %x00 transaction-v1   ; V1

transaction-effects = %x00 transaction-effects-v1   ; V1

transaction-effects-v1 = execution-status                   ; status
                         u64                                ; epoch
                         gas-cost-summary                   ; gas-used
                         digest                             ; transaction-digest
                         (option u32)                       ; gas-object-index
                         (option digest)                    ; events-digest
                         (vector digest)                    ; dependencies
                         u64                                ; lamport-version
                         (vector changed-object)            ; changed-objects
                         (vector unchanged-shared-object)   ; unchanged-shared-objects
                         (option digest)                    ; auxiliary-data-digest

transaction-events = (vector event)

transaction-expiration = %x00   ; None
                       / %x01 u64   ; Epoch

transaction-kind = %x00 programmable-transaction   ; ProgrammableTransaction
                 / %x01 genesis-transaction   ; Genesis
                 / %x02 consensus-commit-prologue-v1   ; ConsensusCommitPrologueV1
                 / %x03 authenticator-state-update-v1   ; AuthenticatorStateUpdateV1
                 / %x04 (vector end-of-epoch-transaction-kind)   ; EndOfEpoch
                 / %x05 randomness-state-update   ; RandomnessStateUpdate

transaction-v1 = transaction-kind         ; kind
                 address                  ; sender
                 gas-payment              ; gas-payment
                 transaction-expiration   ; expiration

transfer-objects = (vector argument)   ; objects
                   argument            ; address

type-argument-error = %x00   ; TypeNotFound
                    / %x01   ; ConstraintNotSatisfied

type-origin = identifier   ; module-name
              identifier   ; struct-name
              object-id    ; package

type-tag = %x00   ; Bool
         / %x01   ; U8
         / %x02   ; U64
         / %x03   ; U128
         / %x04   ; Address
         / %x05   ; Signer
         / %x06 type-tag   ; Vector
         / %x07 struct-tag   ; Struct
         / %x08   ; U16
         / %x09   ; U32
         / %x0a   ; U256

unchanged-shared-kind = %x00 u64 digest   ; ReadOnlyRoot
                      / %x01 u64   ; MutateDeleted
                      / %x02 u64   ; ReadDeleted
                      / %x03 u64   ; Cancelled
                      / %x04   ; PerEpochConfig

unchanged-shared-object = object-id               ; object-id
                          unchanged-shared-kind   ; kind

upgrade = (vector bytes)       ; modules
          (vector object-id)   ; dependencies
          object-id            ; package
          argument             ; ticket

upgrade-info = object-id   ; upgraded-id
               u64         ; upgraded-version

user-signature = bytes

validator-aggregated-signature = u64                  ; epoch
                                 bls12381-signature   ; signature
                                 bytes                ; bitmap

validator-committee = u64                                   ; epoch
                      (vector validator-committee-member)   ; members

validator-committee-member = bls12381-public-key   ; public-key
                             u64                   ; stake

validator-execution-time-observation = 96OCTET   ; validator
                                       u64 u32   ; duration

version-assignment = object-id   ; object-id
                     u64         ; version
